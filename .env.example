# Copy this file to .env and fill in values before running docker-compose.
# DO NOT commit .env to version control.

# Backend JWT signing secret — must be at least 32 characters
JWT_SECRET=transit-demo-secret-change-in-prod-min-32-chars

# MongoDB connection URI (used when NOT using docker-compose, e.g. local dev)
MONGODB_URI=mongodb://localhost:27017/transitdb

# Frontend URL for CORS whitelist (backend)
FRONTEND_URL=http://localhost:3000

# mongo-express admin credentials
ME_USER=admin
ME_PASS=changeme
